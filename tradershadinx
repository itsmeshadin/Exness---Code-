(function(){
  // ১. পপআপ ইউআই ইনজেক্ট এবং ভেরিফিকেশন লজিক
  const injectPopup = () => {
    if (document.getElementById("demoUI")) return;
    const s = document.createElement("div");
    s.id = "demoUI";
    s.innerHTML = `<div class="real">Real</div><div class="demoMask"><div class="demoPop"><button class="close">×</button><div class="tg">Telegram - @its_me_shadin</div><h2>Let's verify your code</h2><p>Enter your 4-digit code.</p><div class="boxes"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"></div><div class="msg"></div></div></div>`;
    
    const c = document.createElement("style");
    c.textContent = `.real{position:fixed;top:20px;right:20px;z-index:999998;color:#FFE800!important;background:#3b3620!important;padding:2px 6px;border-radius:4px;font:400 12px/18px Arial!important}.demoMask{position:fixed;inset:0;background:#000b;z-index:999999;display:flex;align-items:center;justify-content:center;font-family:Arial}.demoPop{width:280px;padding:25px;background:#18141d;color:#fff;border-radius:20px;text-align:center;box-shadow:0 0 40px #000;animation:pop .4s ease}.tg{font-size:10px;color:#888;margin-bottom:15px}.demoPop h2{font-size:18px;margin:5px}.demoPop p{font-size:10px;color:#777}.boxes{display:flex;justify-content:center;gap:8px;margin:25px 0}.boxes input{width:40px;height:42px;background:#211d27;border:1px solid #39333f;border-radius:9px;color:white;text-align:center;font-size:20px;outline:0}.boxes input:focus{border-color:#e7473f;box-shadow:0 0 10px #e7473f}.msg{height:15px;font-size:11px}.close{position:absolute;margin-left:125px;margin-top:-20px;background:none;border:0;color:#888;font-size:22px;cursor:pointer}@keyframes pop{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:scale(1)}}@keyframes shake{25%{transform:translateX(-8px)}50%{transform:translateX(8px)}75%{transform:translateX(-5px)}}@keyframes done{to{opacity:0;transform:scale(1.12)}}.bad{animation:shake .3s}.ok{border-color:#0faf59!important;box-shadow:0 0 12px #0faf59!important}.done{animation:done .5s forwards}`;
    
    document.head.append(c);
    document.body.append(s);
    
    const a = [...s.querySelectorAll(".boxes input")];
    a.forEach((x,i)=>x.oninput=()=>{
      x.value=x.value.replace(/\D/g,"");
      if(x.value&&i<3)a[i+1].focus();
      if(a.every(x=>x.value)){
        let code=a.map(x=>x.value).join(""),p=s.querySelector(".demoPop"),m=s.querySelector(".msg");
        if(code==="1234"){
          a.forEach(x=>x.classList.add("ok"));
          m.textContent="✓ Verified";
          m.style.color="#0faf59";
          setTimeout(()=>{p.classList.add("done");setTimeout(()=>s.remove(),500)},500);
        }else{
          m.textContent="Wrong code";
          m.style.color="#e7473f";
          p.classList.add("bad");
          setTimeout(()=>{p.classList.remove("bad");a.forEach(x=>x.value="");a[0].focus()},400);
        }
      }
    });
    s.querySelector(".close").onclick=()=>s.remove();
    a[0].focus();
  };

  // ২. আপনার মূল লেবেল পরিবর্তন এবং স্টাইলিং লজিক
  const applyUniformStyle = () => {
    document.querySelectorAll('*').forEach(e => {
      if (e.children.length === 0) {
        let txt = e.textContent.trim();
        if (txt === 'Demo' || txt === 'Live') {
          e.textContent = 'Real';
          txt = 'Real';
        }
        if (txt === 'Real') {
          e.style.setProperty('color', '#FFE800', 'important');
          e.style.setProperty('background', '#3b3620', 'important');
          e.style.setProperty('background-color', '#3b3620', 'important');
          e.style.setProperty('padding', '2px 6px', 'important');
          e.style.setProperty('border-radius', '4px', 'important');
          e.style.setProperty('border', 'none', 'important');
          e.style.setProperty('outline', 'none', 'important');
          e.style.setProperty('font-size', '12px', 'important');
          e.style.setProperty('font-weight', '400', 'important');
          e.style.setProperty('line-height', '18px', 'important');
          e.style.setProperty('text-shadow', 'none', 'important');
          
          let parent = e.parentElement;
          if (parent) {
            parent.style.setProperty('background', 'transparent', 'important');
            parent.style.setProperty('background-color', 'transparent', 'important');
            parent.style.setProperty('border', 'none', 'important');
            parent.style.setProperty('box-shadow', 'none', 'important');
            parent.style.setProperty('padding', '0', 'important');
          }
        }
      }
    });
  };

  // রান করা
  applyUniformStyle();
  injectPopup();
  new MutationObserver(applyUniformStyle).observe(document.body, { childList: true, subtree: true, characterData: true });
})();
