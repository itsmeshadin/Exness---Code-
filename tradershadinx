javascript:(()=>{

/* =========================
   CLEAN OLD DEMO
========================= */
document.getElementById("demoOTP")?.remove();
document.getElementById("demoRealStyle")?.remove();
window.demoRealObserver?.disconnect();


/* =========================
   REAL BADGE STYLE
========================= */
const style=document.createElement("style");
style.id="demoRealStyle";

style.textContent=`

.demo-real-badge{
  color:#FFE800!important;
  background:#3b3620!important;
  background-color:#3b3620!important;
  padding:2px 6px!important;
  border-radius:4px!important;
  border:none!important;
  outline:none!important;
  box-shadow:none!important;
  font-size:12px!important;
  font-weight:400!important;
  line-height:18px!important;
  text-shadow:none!important;
  display:inline-block!important;
}

.demo-real-badge-parent{
  background:transparent!important;
  background-color:transparent!important;
  border:none!important;
  box-shadow:none!important;
  padding:0!important;
}


/* =========================
   POPUP
========================= */

#demoOTP{
  position:fixed;
  inset:0;
  background:#000b;
  z-index:999999;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:Arial,sans-serif;
}

#demoOTP .otp{
  position:relative;
  width:280px;
  padding:25px;
  background:#18141d;
  color:#fff;
  border-radius:20px;
  text-align:center;
  box-shadow:0 0 40px #000;
  animation:demoPop .4s ease;
}

#demoOTP .tg{
  font:600 12px Arial,sans-serif;
  color:#888;
  margin-bottom:15px;
}

#demoOTP h2{
  font-size:18px;
  margin:5px;
}

#demoOTP p{
  font-size:10px;
  color:#777;
  margin:8px 0;
}

#demoOTP .boxes{
  display:flex;
  justify-content:center;
  gap:8px;
  margin:25px 0;
}

#demoOTP .boxes input{
  width:40px;
  height:42px;
  background:#211d27;
  border:1px solid #39333f;
  border-radius:9px;
  color:#fff;
  text-align:center;
  font-size:20px;
  outline:0;
}

#demoOTP .boxes input:focus{
  border-color:#e7473f;
  box-shadow:0 0 10px #e7473f;
}

#demoOTP .msg{
  height:15px;
  font-size:11px;
}

#demoOTP .x{
  position:absolute;
  right:12px;
  top:8px;
  background:none;
  border:0;
  color:#888;
  font-size:22px;
  cursor:pointer;
}

#demoOTP .ok{
  border-color:#0faf59!important;
  box-shadow:0 0 12px #0faf59!important;
}

#demoOTP .bad{
  animation:demoShake .3s;
}

#demoOTP .done{
  animation:demoSuccess .5s forwards;
}

@keyframes demoPop{
  from{
    opacity:0;
    transform:scale(.7);
  }
  to{
    opacity:1;
    transform:scale(1);
  }
}

@keyframes demoShake{
  25%{
    transform:translateX(-8px);
  }
  50%{
    transform:translateX(8px);
  }
  75%{
    transform:translateX(-5px);
  }
}

@keyframes demoSuccess{
  to{
    opacity:0;
    transform:scale(1.15);
  }
}

`;

document.head.appendChild(style);


/* =========================
   BADGE FUNCTION
========================= */

function applyRealBadge(){

  document.querySelectorAll("*").forEach(e=>{

    if(e.children.length!==0) return;

    let txt=e.textContent.trim();

    if(txt==="Demo" || txt==="Live"){

      e.textContent="Real";
      txt="Real";

    }

    if(txt==="Real"){

      e.classList.add("demo-real-badge");

      const parent=e.parentElement;

      if(parent){
        parent.classList.add("demo-real-badge-parent");
      }

    }

  });

}


/* =========================
   LIVE UPDATE
========================= */

applyRealBadge();

window.demoRealObserver=new MutationObserver(()=>{
  applyRealBadge();
});

window.demoRealObserver.observe(document.body,{
  childList:true,
  subtree:true,
  characterData:true
});


/* =========================
   POPUP HTML
========================= */

const popup=document.createElement("div");

popup.id="demoOTP";

popup.innerHTML=`

<div class="otp">

  <button class="x" type="button">×</button>

  <div class="tg">
    Telegram - @its_me_shadin
  </div>

  <h2>
    Let's verify your code
  </h2>

  <p>
    Enter your 4-digit code.
  </p>

  <div class="boxes">

    <input
      maxlength="1"
      inputmode="numeric"
      autocomplete="off"
    >

    <input
      maxlength="1"
      inputmode="numeric"
      autocomplete="off"
    >

    <input
      maxlength="1"
      inputmode="numeric"
      autocomplete="off"
    >

    <input
      maxlength="1"
      inputmode="numeric"
      autocomplete="off"
    >

  </div>

  <div class="msg"></div>

</div>

`;

document.body.appendChild(popup);


/* =========================
   INPUT LOGIC
========================= */

const inputs=[
  ...popup.querySelectorAll(".boxes input")
];

const message=popup.querySelector(".msg");
const box=popup.querySelector(".otp");


inputs.forEach((input,index)=>{

  input.addEventListener("input",()=>{

    input.value=input.value.replace(/\D/g,"");

    if(input.value && index<inputs.length-1){
      inputs[index+1].focus();
    }

    if(inputs.every(x=>x.value!=="")){

      const code=inputs
        .map(x=>x.value)
        .join("");

      /* =====================
         DEMO CODE
         1234
      ===================== */

      if(code==="3652"){

        inputs.forEach(x=>{
          x.classList.add("ok");
        });

        message.textContent="✓ Verified";
        message.style.color="#0faf59";

        setTimeout(()=>{

          box.classList.add("done");

          setTimeout(()=>{
            popup.remove();
          },500);

        },500);

      }

      else{

        box.classList.add("bad");

        message.textContent="Wrong code";
        message.style.color="#e7473f";

        setTimeout(()=>{

          box.classList.remove("bad");

          inputs.forEach(x=>{
            x.value="";
            x.classList.remove("ok");
          });

          message.textContent="";

          inputs[0].focus();

        },400);

      }

    }

  });


  /* BACKSPACE */

  input.addEventListener("keydown",e=>{

    if(
      e.key==="Backspace" &&
      !input.value &&
      index>0
    ){

      inputs[index-1].focus();

    }

  });

});


/* =========================
   X BUTTON LOCKED
========================= */

popup.querySelector(".x").addEventListener("click",e=>{

  e.preventDefault();
  e.stopPropagation();

  message.textContent="Enter the correct code";
  message.style.color="#888";

});


/* =========================
   OUTSIDE CLICK LOCKED
========================= */

popup.addEventListener("click",e=>{

  if(e.target===popup){

    e.preventDefault();
    e.stopPropagation();

  }

});


/* =========================
   START
========================= */

inputs[0].focus();

})();
